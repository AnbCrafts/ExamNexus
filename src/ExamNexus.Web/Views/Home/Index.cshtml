@using ExamNexus.Domain.Enums
@{
    ViewData["Title"] = "ExamNexus - Multi-Tenant AI Proctored Assessment SaaS";
    Layout = "_Layout";
}

<div class="landing-page overflow-hidden">
    <!-- Hero Section -->
    <section class="hero-section text-white py-5 position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);">
        <div class="position-absolute top-0 start-0 w-100 h-100 opacity-10" style="background-image: radial-gradient(#6366f1 1px, transparent 1px); background-size: 24px 24px;"></div>
        <div class="container py-5 position-relative">
            @if (TempData["PlanRequestSuccess"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-lg mb-4 rounded-3 p-3 text-dark bg-white" role="alert">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-success text-white p-2 me-3">
                            <i class="fa-solid fa-check fs-5"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1 text-success">Plan Request Received!</h6>
                            <div class="small">@TempData["PlanRequestSuccess"]</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["PlanRequestError"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-lg mb-4 rounded-3 p-3" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["PlanRequestError"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row align-items-center g-4 g-lg-5">
                <div class="col-lg-7 text-center text-lg-start">
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 text-white-50 small mb-3 border border-white border-opacity-10">
                        <span class="badge bg-primary">v2.4 Live</span>
                        <span>Enterprise Multi-Tenant Examination Cloud</span>
                    </div>
                    <h1 class="display-4 fw-black tracking-tight mb-3 lh-sm">
                        High-Stakes Online Exams with <span style="background: linear-gradient(to right, #818cf8, #c084fc); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Live Proctoring</span>
                    </h1>
                    <p class="lead text-white-50 mb-4 fw-normal">
                        ExamNexus empowers universities, corporate enterprises, and accreditation boards to create, schedule, and execute cheat-resilient assessments with isolated tenant data and live browser tracking.
                    </p>

                    <!-- Candidate Quick Join Card -->
                    <div class="card border-0 shadow-lg rounded-4 p-4 text-start bg-white text-dark mb-4" style="max-width: 580px;">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-primary-subtle text-primary fw-bold px-2 py-1">Candidate Portal</span>
                            <span class="text-muted small">Have an exam passcode from your instructor?</span>
                        </div>
                        <form asp-action="QuickJoin" method="get" class="d-flex flex-column flex-sm-row gap-2 mt-2">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="fa-solid fa-key"></i>
                                </span>
                                <input type="text" name="code" class="form-control form-control-lg border-start-0 font-monospace text-uppercase fw-bold" placeholder="e.g. AZ900-LIVE" required style="letter-spacing: 1px;" />
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-4 text-nowrap d-flex align-items-center justify-content-center gap-2 shadow-sm">
                                <span>Join Exam</span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </button>
                        </form>
                        <div class="text-muted small mt-2 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-shield-halved text-success"></i>
                            <span>Protected by live anti-cheat SignalR tab-switch detection</span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                        <a href="#plans" class="btn btn-outline-light btn-lg px-4 fw-semibold">
                            <i class="fa-solid fa-layer-group me-2"></i> View Subscription Plans
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-secondary btn-lg px-4 fw-semibold bg-white bg-opacity-10 border-white border-opacity-25">
                            <i class="fa-solid fa-right-to-bracket me-2"></i> Sign In to Tenant
                        </a>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="card border-0 rounded-4 shadow-2xl p-4 bg-white bg-opacity-10 backdrop-blur border border-white border-opacity-20 text-white">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="fa-solid fa-circle text-white me-1 animate-pulse"></i> LIVE PROCTORING</span>
                            <span class="small font-monospace text-white-50">Heartbeat: Active</span>
                        </div>
                        <div class="bg-black bg-opacity-40 p-3 rounded-3 mb-3 border border-white border-opacity-10">
                            <div class="d-flex align-items-center justify-content-between small text-white-50 mb-2">
                                <span>Candidate Session</span>
                                <span class="badge bg-success">In Progress</span>
                            </div>
                            <div class="fw-bold fs-5">Alex Rivera &bull; AZ-900 Midterm</div>
                            <div class="progress mt-2" style="height: 6px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: 75%"></div>
                            </div>
                        </div>

                        <div class="d-flex flex-column gap-2 small">
                            <div class="p-2 rounded bg-white bg-opacity-5 d-flex align-items-center justify-content-between">
                                <span><i class="fa-solid fa-arrows-split-up-and-left text-warning me-2"></i> Tab Switch Limit:</span>
                                <span class="fw-bold">2 Allowed</span>
                            </div>
                            <div class="p-2 rounded bg-white bg-opacity-5 d-flex align-items-center justify-content-between">
                                <span><i class="fa-solid fa-bolt text-info me-2"></i> Auto-Grading:</span>
                                <span class="fw-bold text-success">Instant on Submit</span>
                            </div>
                            <div class="p-2 rounded bg-white bg-opacity-5 d-flex align-items-center justify-content-between">
                                <span><i class="fa-solid fa-database text-primary me-2"></i> Tenant Schema Isolation:</span>
                                <span class="fw-bold">Acme Corp Academy</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Role Hub Section -->
    <section class="py-5 bg-light border-bottom">
        <div class="container py-4">
            <div class="text-center mb-5">
                <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2 rounded-pill mb-2">Platform Capabilities</span>
                <h2 class="fw-bold text-dark">Built for Every Examination Stakeholder</h2>
                <p class="text-muted">A comprehensive, end-to-end evaluation suite tailored to candidates, faculty, and administrators.</p>
            </div>

            <div class="row g-4">
                <!-- 1. Candidates -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white hover-lift">
                        <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 mx-auto mb-3" style="width: 64px; height: 64px;">
                            <i class="fa-solid fa-user-graduate fs-3"></i>
                        </div>
                        <h5 class="fw-bold mb-2">Candidates</h5>
                        <p class="text-muted small mb-4">Seamless test taking with autosave, timer countdown, dynamic question navigation, and instant result scorecards.</p>
                        <a href="#quick-join" class="btn btn-outline-success btn-sm mt-auto fw-semibold" onclick="document.querySelector('input[name=code]').focus();">
                            Enter Exam Code
                        </a>
                    </div>
                </div>

                <!-- 2. Instructors -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white hover-lift">
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 mx-auto mb-3" style="width: 64px; height: 64px;">
                            <i class="fa-solid fa-chalkboard-user fs-3"></i>
                        </div>
                        <h5 class="fw-bold mb-2">Instructors</h5>
                        <p class="text-muted small mb-4">Create assessments, configure multiple-choice question options, generate shareable links, and review submissions.</p>
                        <a asp-controller="Account" asp-action="DemoLogin" asp-route-role="instructor" class="btn btn-outline-primary btn-sm mt-auto fw-semibold">
                            Instructor Login
                        </a>
                    </div>
                </div>

                <!-- 3. Proctors -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white hover-lift">
                        <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3 mx-auto mb-3" style="width: 64px; height: 64px;">
                            <i class="fa-solid fa-video fs-3"></i>
                        </div>
                        <h5 class="fw-bold mb-2">Live Proctors</h5>
                        <p class="text-muted small mb-4">Real-time SignalR command center, candidate heartbeat logs, instant tab-switch alerts, and direct session termination.</p>
                        <a asp-controller="Account" asp-action="DemoLogin" asp-route-role="proctor" class="btn btn-outline-warning btn-sm mt-auto fw-semibold">
                            Proctor Console
                        </a>
                    </div>
                </div>

                <!-- 4. Tenant & SuperAdmin -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white hover-lift">
                        <div class="rounded-circle bg-dark bg-opacity-10 text-dark p-3 mx-auto mb-3" style="width: 64px; height: 64px;">
                            <i class="fa-solid fa-crown fs-3 text-warning"></i>
                        </div>
                        <h5 class="fw-bold mb-2">Platform Admin</h5>
                        <p class="text-muted small mb-4">Global tenant provisioning, subscription quota enforcement, candidate seat limits, and purchase request review.</p>
                        <a asp-controller="Account" asp-action="DemoLogin" asp-route-role="superadmin" class="btn btn-outline-dark btn-sm mt-auto fw-semibold">
                            SuperAdmin Access
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Pricing / Subscription Plans Section -->
    <section class="py-5 bg-white" id="plans">
        <div class="container py-4">
            <div class="text-center mb-5">
                <span class="badge bg-indigo-subtle text-indigo fw-bold px-3 py-2 rounded-pill mb-2" style="background-color: #e0e7ff; color: #4338ca;">Subscription Plans</span>
                <h2 class="fw-bold text-dark">Transparent Pricing for Organizations of Any Size</h2>
                <p class="text-muted">Choose the right capacity tier for your institution. Request your workspace and start assessing in minutes.</p>
            </div>

            <div class="row g-4 align-items-stretch justify-content-center">
                <!-- Free Plan -->
                <div class="col-lg-4">
                    <div class="card h-100 border shadow-sm rounded-4 p-4 bg-white d-flex flex-column">
                        <div class="mb-4">
                            <span class="badge bg-secondary-subtle text-secondary px-3 py-1 rounded-pill fw-bold">Starter</span>
                            <h3 class="fw-bold mt-2 mb-1">Free Tier</h3>
                            <p class="text-muted small">Ideal for pilot testing, small classrooms, and introductory assessments.</p>
                            <div class="fs-1 fw-black text-dark mt-3">$0 <span class="fs-6 text-muted fw-normal">/ month</span></div>
                        </div>

                        <ul class="list-unstyled mb-4 small d-flex flex-column gap-2">
                            <li class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-check text-success"></i>
                                <span><strong>2 Active Assessments</strong> maximum</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-check text-success"></i>
                                <span>Up to <strong>50 Candidate Slots</strong></span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-check text-success"></i>
                                <span>Standard Question & Option Builder</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-check text-success"></i>
                                <span>Automated Grading & Result Scorecards</span>
                            </li>
                            <li class="d-flex align-items-center gap-2 text-muted">
                                <i class="fa-solid fa-xmark text-muted"></i>
                                <span>Realtime Live SignalR Proctor Hub</span>
                            </li>
                        </ul>

                        <button type="button" class="btn btn-outline-dark fw-bold w-100 mt-auto py-2 rounded-3" onclick="openRequestModal('Free', 50)">
                            Request Free Workspace
                        </button>
                    </div>
                </div>

                <!-- Professional Plan (Featured) -->
                <div class="col-lg-4">
                    <div class="card h-100 border-2 border-primary shadow-lg rounded-4 p-4 bg-white d-flex flex-column position-relative" style="border-color: #4f46e5 !important;">
                        <span class="position-absolute top-0 start-50 translate-middle badge rounded-pill px-3 py-2 text-white fw-bold shadow-sm" style="background-color: #4f46e5;">
                            MOST POPULAR
                        </span>
                        <div class="mb-4">
                            <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill fw-bold">Growth</span>
                            <h3 class="fw-bold mt-2 mb-1">Professional</h3>
                            <p class="text-muted small">For departments, colleges, and training institutes conducting frequent evaluations.</p>
                            <div class="fs-1 fw-black text-dark mt-3">$149 <span class="fs-6 text-muted fw-normal">/ month</span></div>
                        </div>

                        <ul class="list-unstyled mb-4 small d-flex flex-column gap-2">
                            <li class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-check text-success"></i>
                                <span><strong>5 Active Assessments</strong> maximum</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-check text-success"></i>
                                <span>Up to <strong>1,000 Candidate Slots</strong></span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-check text-success"></i>
                                <span><strong>Live SignalR Proctoring</strong> & Tab Switch Alerts</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-check text-success"></i>
                                <span>Auto-flagging & Proctor Heartbeats</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-check text-success"></i>
                                <span>Custom Organization Identifier (Slug)</span>
                            </li>
                        </ul>

                        <button type="button" class="btn btn-primary fw-bold w-100 mt-auto py-2 rounded-3 shadow-sm" style="background-color: #4f46e5; border-color: #4f46e5;" onclick="openRequestModal('Professional', 1000)">
                            Request Professional Plan
                        </button>
                    </div>
                </div>

                <!-- Enterprise Plan -->
                <div class="col-lg-4">
                    <div class="card h-100 border shadow-sm rounded-4 p-4 bg-white d-flex flex-column">
                        <div class="mb-4">
                            <span class="badge bg-purple-subtle text-purple px-3 py-1 rounded-pill fw-bold" style="background-color: #f3e8ff; color: #7e22ce;">Enterprise</span>
                            <h3 class="fw-bold mt-2 mb-1">Enterprise</h3>
                            <p class="text-muted small">For large universities, enterprise certifications, and government testing agencies.</p>
                            <div class="fs-1 fw-black text-dark mt-3">Custom <span class="fs-6 text-muted fw-normal">/ tier</span></div>
                        </div>

                        <ul class="list-unstyled mb-4 small d-flex flex-column gap-2">
                            <li class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-check text-success"></i>
                                <span><strong>Unlimited Assessments</strong> quota</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-check text-success"></i>
                                <span><strong>5,000+ Candidate Slots</strong> (Scalable)</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-check text-success"></i>
                                <span>Full Proctor Intervention & Kick Capability</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-check text-success"></i>
                                <span>Dedicated Tenant Schema & Audit Trail</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-check text-success"></i>
                                <span>Dedicated Platform Account Manager & SLA</span>
                            </li>
                        </ul>

                        <button type="button" class="btn btn-dark fw-bold w-100 mt-auto py-2 rounded-3" onclick="openRequestModal('Enterprise', 5000)">
                            Request Enterprise Plan
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Platform Highlights Section -->
    <section class="py-5 bg-light border-top">
        <div class="container py-4">
            <div class="row align-items-center g-4 g-lg-5">
                <div class="col-lg-6">
                    <span class="badge bg-success-subtle text-success fw-bold px-3 py-2 rounded-pill mb-2">Architecture</span>
                    <h2 class="fw-bold mb-3">Enterprise Multi-Tenant Security & Clean Separation</h2>
                    <p class="text-muted">
                        ExamNexus is architected on ASP.NET Core 9 and EF Core with automated query filters. Every database operation guarantees that tenant records are completely isolated and immune to cross-tenant data leakage.
                    </p>
                    <div class="d-flex flex-column gap-3 mt-4">
                        <div class="d-flex gap-3">
                            <div class="rounded-3 bg-white shadow-sm p-3 text-primary d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="fa-solid fa-database"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Global Query Filters</h6>
                                <p class="text-muted small mb-0">Transparent tenant context injection prevents unauthorized read or write access.</p>
                            </div>
                        </div>
                        <div class="d-flex gap-3">
                            <div class="rounded-3 bg-white shadow-sm p-3 text-success d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="fa-solid fa-bolt"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">High-Throughput SignalR Hub</h6>
                                <p class="text-muted small mb-0">Sub-second anti-cheat proctoring events streamed without database polling overhead.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 text-center">
                    <div class="card border-0 shadow-lg rounded-4 p-4 bg-white text-start">
                        <div class="d-flex align-items-center justify-content-between pb-3 border-bottom mb-3">
                            <span class="fw-bold text-dark"><i class="fa-solid fa-chart-line me-2 text-primary"></i>Live Platform Statistics</span>
                            <span class="badge bg-success-subtle text-success">Systems Operational</span>
                        </div>
                        <div class="row g-3 text-center">
                            <div class="col-4">
                                <div class="fs-4 fw-bold text-dark">99.98%</div>
                                <div class="text-muted small">Uptime SLA</div>
                            </div>
                            <div class="col-4">
                                <div class="fs-4 fw-bold text-primary">&lt; 150ms</div>
                                <div class="text-muted small">SignalR Latency</div>
                            </div>
                            <div class="col-4">
                                <div class="fs-4 fw-bold text-success">100%</div>
                                <div class="text-muted small">Data Isolation</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Modal: Request Subscription Plan -->
<div class="modal fade" id="requestPlanModal" tabindex="-1" aria-labelledby="requestPlanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form asp-action="RequestPlan" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white p-4">
                    <div>
                        <h5 class="modal-title fw-bold" id="requestPlanModalLabel">
                            <i class="fa-solid fa-file-invoice-dollar me-2 text-warning"></i> Request Organization Subscription Plan
                        </h5>
                        <p class="text-white-50 small mb-0 mt-1">Submit your institution information for fast-track tenant provisioning.</p>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label class="form-label fw-semibold small">Organization / Institution Name <span class="text-danger">*</span></label>
                            <input type="text" name="OrganizationName" class="form-control" placeholder="e.g. Cambridge Institute of Technology" required />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold small">Suggested URL Identifier (Slug)</label>
                            <input type="text" name="SuggestedIdentifier" class="form-control" placeholder="e.g. cambridge-tech" pattern="^[a-z0-9-]+$" />
                            <div class="form-text small">Lowercase letters, numbers, and hyphens.</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Contact Person Name <span class="text-danger">*</span></label>
                            <input type="text" name="ContactName" class="form-control" placeholder="Dr. Robert Smith" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Work Email Address <span class="text-danger">*</span></label>
                            <input type="email" name="ContactEmail" class="form-control" placeholder="robert.smith@cambridge.edu" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Contact Phone</label>
                            <input type="tel" name="ContactPhone" class="form-control" placeholder="+1 (555) 000-0000" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Selected Plan Tier <span class="text-danger">*</span></label>
                            <select name="RequestedPlan" id="modalPlanSelect" class="form-select">
                                <option value="@((int)TenantPlan.Free)">Free Tier (Quota: 2 exams)</option>
                                <option value="@((int)TenantPlan.Professional)">Professional Tier (Quota: 5 exams)</option>
                                <option value="@((int)TenantPlan.Enterprise)">Enterprise Tier (Unlimited)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Estimated Candidate Slots <span class="text-danger">*</span></label>
                            <input type="number" name="EstimatedCandidates" id="modalCandidatesInput" class="form-control" value="500" min="10" max="100000" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Additional Requirements / Notes</label>
                        <textarea name="AdditionalNotes" class="form-control" rows="3" placeholder="Tell us about your examination schedule, estimated peak concurrency, or proctoring needs..."></textarea>
                    </div>

                    <div class="alert alert-info py-2 px-3 small rounded-3 mb-0 border-0">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        Once approved by platform administrators, you will receive your tenant login credentials to immediately configure courses, invite staff, and launch assessments.
                    </div>
                </div>

                <div class="modal-footer p-3 bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">
                        <i class="fa-solid fa-paper-plane me-1"></i> Submit Plan Request
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openRequestModal(planName, defaultCandidates) {
            const planSelect = document.getElementById('modalPlanSelect');
            const candidatesInput = document.getElementById('modalCandidatesInput');

            if (planName === 'Free') {
                planSelect.value = "@((int)TenantPlan.Free)";
                candidatesInput.value = 50;
            } else if (planName === 'Professional') {
                planSelect.value = "@((int)TenantPlan.Professional)";
                candidatesInput.value = 1000;
            } else if (planName === 'Enterprise') {
                planSelect.value = "@((int)TenantPlan.Enterprise)";
                candidatesInput.value = defaultCandidates || 5000;
            }

            const modal = new bootstrap.Modal(document.getElementById('requestPlanModal'));
            modal.show();
        }
    </script>
}
