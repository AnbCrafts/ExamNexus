@model List<ExamSummaryDto>
@{
    ViewData["Title"] = "Assessment Lobby";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="fa-solid fa-file-signature text-primary me-2"></i> Assessment Catalog &amp; Lobby
        </h3>
        <p class="text-muted mb-0">Select an assessment to begin. Ensure your webcam and stable network connection are ready.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-light text-secondary border px-3 py-2">
            <i class="fa-solid fa-clock me-1 text-primary"></i> Timed Sessions
        </span>
        <span class="badge bg-light text-secondary border px-3 py-2">
            <i class="fa-solid fa-shield-halved me-1 text-warning"></i> SignalR Monitored
        </span>
    </div>
</div>

<div class="row g-4">
    @if (Model.Any())
    {
        @foreach (var exam in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card card-enterprise h-100 d-flex flex-column">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary bg-opacity-10 text-primary fw-bold">@exam.CourseCode</span>
                            <span class="badge bg-light text-dark border">
                                <i class="fa-regular fa-clock me-1 text-muted"></i> @exam.DurationMinutes Mins
                            </span>
                        </div>

                        <h5 class="fw-bold text-dark mb-1">@exam.Title</h5>
                        <div class="text-muted small mb-3">@exam.CourseTitle</div>

                        <div class="p-3 bg-light rounded-3 mb-4 mt-auto">
                            <div class="d-flex justify-content-between text-muted small mb-1">
                                <span>Total Questions:</span>
                                <strong class="text-dark">@exam.TotalQuestions Questions</strong>
                            </div>
                            <div class="d-flex justify-content-between text-muted small mb-1">
                                <span>Total Points:</span>
                                <strong class="text-dark">@exam.TotalMarks Pts</strong>
                            </div>
                            <div class="d-flex justify-content-between text-muted small">
                                <span>Passing Grade:</span>
                                <strong class="text-dark">@exam.PassingScorePercent%</strong>
                            </div>
                        </div>

                        @if (exam.HasActiveSession && exam.ActiveSessionId.HasValue)
                        {
                            <div class="alert alert-warning py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                <span>You have an ongoing attempt!</span>
                            </div>
                            <a asp-action="Take" asp-route-sessionId="@exam.ActiveSessionId.Value" class="btn btn-warning w-100 fw-bold">
                                <i class="fa-solid fa-arrow-right me-1"></i> Resume Exam Attempt
                            </a>
                        }
                        else if (exam.LastSessionStatus == ExamSessionStatus.Submitted)
                        {
                            <a asp-action="Index" class="btn btn-outline-success w-100 fw-semibold mb-2" onclick="openStartModal('@exam.Id', '@exam.Title', '@exam.AccessCode'); return false;">
                                <i class="fa-solid fa-rotate-right me-1"></i> Retake Assessment
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-brand-primary w-100" onclick="openStartModal('@exam.Id', '@exam.Title', '@exam.AccessCode')">
                                <i class="fa-solid fa-play me-1"></i> Enter Assessment
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="text-muted">No assessments currently active for your organization.</div>
        </div>
    }
</div>

<!-- Modal: Enter Passcode & Launch Exam -->
<div class="modal fade" id="startExamModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header bg-dark text-white p-4">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-shield-halved text-warning me-2"></i> Launch Assessment Session
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Start" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ExamId" id="modalExamId" />
                <div class="modal-body p-4">
                    <h5 class="fw-bold text-dark mb-2" id="modalExamTitle">Assessment Title</h5>
                    <p class="text-muted small mb-4">
                        Please confirm your readiness. Once started, real-time proctoring telemetry will monitor tab switches and browser focus.
                    </p>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">
                            <i class="fa-solid fa-key me-1 text-primary"></i> Assessment Access Passcode
                        </label>
                        <input type="text" name="AccessCode" id="modalAccessCode" class="form-control form-control-lg fw-semibold font-monospace" placeholder="e.g. AZ900-2026" required />
                        <div class="form-text small">Passcode configured by your instructor. Auto-filled for testing.</div>
                    </div>
                </div>
                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-brand-primary px-4 fw-bold">
                        <i class="fa-solid fa-lock-open me-1"></i> Start Assessment Now
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openStartModal(examId, title, code) {
            document.getElementById('modalExamId').value = examId;
            document.getElementById('modalExamTitle').innerText = title;
            document.getElementById('modalAccessCode').value = code;
            var modal = new bootstrap.Modal(document.getElementById('startExamModal'));
            modal.show();
        }
    </script>
}
