@{
    ViewData["Title"] = "Access Restricted";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5 text-center">
        <div class="card card-enterprise p-5">
            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 rounded-circle" style="width: 80px; height: 80px;">
                    <i class="fa-solid fa-ban text-danger fs-1"></i>
                </div>
            </div>
            <h3 class="fw-bold text-dark mb-2">Access Restricted</h3>
            <p class="text-muted mb-4">
                Your role or active tenant profile does not possess authorization to access this secured SaaS proctoring resource.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="fa-solid fa-arrow-left me-1"></i> Return to Dashboard
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-brand-primary px-4">
                    Switch Role / Tenant
                </a>
            </div>
        </div>
    </div>
</div>
