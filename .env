# =============================================================
# ExamNexus SaaS Production Environment Configuration
# Ready to upload or paste directly into Render / Cloud Hosts
# =============================================================

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080

# 100% Free SQLite Relational SQL Database (Zero Credit Cards Required)
DatabaseSettings__UseSqlServer=false
ConnectionStrings__DefaultConnection=Data Source=ExamNexus.db

# Security & JWT Tokens
JwtSettings__Secret=ExamNexus_SuperSecretSaaSKey_2026_Minimum32CharsLong!@#$
JwtSettings__Issuer=ExamNexus
JwtSettings__Audience=ExamNexus-ProctorApp
JwtSettings__ExpiryMinutes=60
